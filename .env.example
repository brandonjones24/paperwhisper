# paperwhisper — enable every backend you use. DIRECTION=all treats them as
# equals: the furthest-ahead copy of a book is the leader; the others catch up.

# --- Audiobookshelf ---
ABS_URL=http://audiobookshelf:13378
# Settings -> Users -> your user -> API Token
ABS_TOKEN=changeme
ABS_VERIFY_TLS=true

# --- reMarkable (rmfakecloud) ---
# Path to rmfakecloud's data dir (the one containing users/<user>/sync).
RMFAKECLOUD_DATA=/rmdata
RMFAKECLOUD_USER=changeme
# Required to *write* the tablet's open page:
# RMFAKECLOUD_URL=http://rmfakecloud:3050
# RMFAKECLOUD_DEVICE_TOKEN=
# or mount an rmapi.conf and set:
# RMAPI_CONFIG=/rmapi/rmapi.conf

# --- Calibre-Web / KOReader kosync ---
# Read progress from app.db; write via kosync HTTP so CWA side effects still fire.
# CALIBRE_LIBRARY=/calibre-library
# CWA_APP_DB=/config/app.db
# CWA_USER_ID=                 # optional: restrict sqlite reads to one CWA user id
# CWA_URL=http://calibre-web:8083
# CWA_USER=
# CWA_PASSWORD=
# CWA_VERIFY_TLS=true

# --- sync ---
# all            : every configured backend is a peer (recommended)
# ebook_to_audio : ebook backends lead, only Audiobookshelf is written
# audio_to_ebook : Audiobookshelf leads, only ebook backends are written
DIRECTION=all

INTERVAL=300                  # backup poll (seconds); 0 = events-only if ABS_EVENTS
DRY_RUN=true                  # keep true until matches look right, then set false

# ABS Socket.io (default: on for DIRECTION=all and audio_to_ebook).
# After listening goes quiet for EVENT_DEBOUNCE seconds — or EVENT_MAX_WAIT of
# continuous playback — sync peers. The tablet picks up a new page on its next sync.
# ABS_EVENTS=true
EVENT_DEBOUNCE=20
EVENT_MAX_WAIT=120

# Optional MQTT status. Set MQTT_HOST to enable.
# MQTT_HOST=mqtt
# MQTT_PORT=1883
# MQTT_USER=
# MQTT_PASSWORD=
# MQTT_PREFIX=paperwhisper

MATCH_THRESHOLD=0.72          # 0-1 fuzzy title/author match cutoff
MIN_DELTA=0.01                # min fractional move before writing ABS / Calibre-Web
MIN_PAGE_DELTA=1              # min page move before writing reMarkable
MIN_PROGRESS=0.005            # ignore items barely started
ALLOW_REWIND=false            # if false, only ever advance a target
CHAPTER_MAP=true
PAGE_LAG=1
AUDIO_LAG=15
LOG_LEVEL=INFO
