# --- rmfakecloud ---
# Path to rmfakecloud's data dir (the one containing users/<user>/sync). Read-only.
RMFAKECLOUD_DATA=/rmdata
# Your rmfakecloud username (the sync subfolder under users/).
RMFAKECLOUD_USER=changeme

# --- Audiobookshelf ---
ABS_URL=http://audiobookshelf:13378
# Settings -> Users -> your user -> API Token
ABS_TOKEN=changeme
ABS_VERIFY_TLS=true

# --- direction ---
# ebook_to_audio : reMarkable reading position -> Audiobookshelf  (reMarkable read-only)
# audio_to_ebook : Audiobookshelf listen position -> reMarkable   (writes to rmfakecloud)
DIRECTION=ebook_to_audio

# --- ebook progress source (for ebook_to_audio) ---
EBOOK_PROVIDER=remarkable     # remarkable | calibreweb
# For the calibreweb provider (reads KOReader 'kosync' progress from Calibre-Web):
#   one or more Calibre library dirs (comma-separated); each must contain metadata.db
# CALIBRE_LIBRARY=/calibre-library
# CWA_APP_DB=/config/app.db    # Calibre-Web app.db (contains kosync_progress)
# CWA_USER_ID=                 # optional: restrict to a single Calibre-Web user id

# --- required ONLY for audio_to_ebook (writing back to the reMarkable) ---
# rmfakecloud base URL (its HTTP API), e.g. http://rmfakecloud:3050
RMFAKECLOUD_URL=
# Device token used to write. Either paste it here...
RMFAKECLOUD_DEVICE_TOKEN=
# ...or mount an rmapi.conf and point at it (the token is read from it):
# RMAPI_CONFIG=/rmapi/rmapi.conf

# --- behaviour ---
INTERVAL=300                  # seconds between passes; 0 = run once and exit
DRY_RUN=true                  # keep true until matches look right, then set false
MATCH_THRESHOLD=0.72          # 0-1 fuzzy title/author match cutoff
MIN_DELTA=0.01                # ebook_to_audio: min fractional move before writing
MIN_PAGE_DELTA=1              # audio_to_ebook: min page move before writing
MIN_PROGRESS=0.005            # ignore items barely started
ALLOW_REWIND=false            # if false, only ever advance the target (protects progress)
LOG_LEVEL=INFO
